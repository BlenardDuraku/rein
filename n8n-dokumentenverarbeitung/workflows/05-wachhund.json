{
  "id": "DfWachhund000001",
  "name": "DF 05 Wachhund",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "DfWachhund000001-1",
      "name": "Alle 5 Minuten",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select docflow.watchdog() as w",
        "options": {}
      },
      "id": "DfWachhund000001-2",
      "name": "Zustand prüfen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "DF_POSTGRES",
          "name": "DF Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst w = $input.first().json.w;\nconst a = [];\nif (w.aeltester_wartend_min > w.grenze_wartezeit_min)\n  a.push(['kritisch', 'queue_stale', `Warteschlange staut sich: ältestes Dokument wartet seit ${w.aeltester_wartend_min} Minuten (${w.warteschlange} wartend).`]);\nif (w.haengende_zurueckgeholt > 0)\n  a.push(['warnung', 'stuck_jobs', `${w.haengende_zurueckgeholt} hängende Verarbeitung(en) wurden automatisch neu eingeplant.`]);\nif (w.export_fehlgeschlagen > 0)\n  a.push(['kritisch', 'exports_failed', `${w.export_fehlgeschlagen} Export(e) endgültig fehlgeschlagen. Daten liegen in docflow.exports bereit.`]);\nif (w.schutzschalter_offen)\n  a.push(['kritisch', 'circuit_open_watch', 'Schutzschalter offen: KI-Dienst gestört, Verarbeitung pausiert automatisch.']);\nif (w.ki_fehlerquote_15min >= 0.3 && !w.schutzschalter_offen)\n  a.push(['warnung', 'llm_errors', `Erhöhte KI-Fehlerquote: ${Math.round(w.ki_fehlerquote_15min * 100)} % in 15 Minuten.`]);\nif (w.neu_zur_pruefung_5min > 0)\n  a.push(['info', 'review_new', `${w.neu_zur_pruefung_5min} neue(s) Dokument(e) zur Prüfung, insgesamt ${w.zur_pruefung} offen.`]);\nreturn a.map(([severity, key, message]) => ({ json: { severity, key, message, details: w } }));"
      },
      "id": "DfWachhund000001-3",
      "name": "Auffälligkeiten bewerten",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select docflow.raise_alert($1, $2, $3, $4::jsonb) as r",
        "options": {
          "queryReplacement": "={{ [$json.severity, $json.key, $json.message, JSON.stringify($json.details)] }}"
        }
      },
      "id": "DfWachhund000001-4",
      "name": "Alarm anlegen",
