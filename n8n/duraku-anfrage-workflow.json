    {
      "id": "a1f0c001-0000-4000-8000-000000000007",
      "name": "Mail an Duraku",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "duraku-glanz@outlook.com",
        "subject": "=Neue Anfrage: {{ $json.data.service }} – {{ $json.data.name }}",
        "bodyContent": "=<div style=\"font-family:Arial,sans-serif;max-width:600px\">\n<h2 style=\"color:#1d4ed8;margin:0 0 12px\">Neue Anfrage über die Website</h2>\n<table style=\"border-collapse:collapse;width:100%\">\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Name</td><td style=\"padding:6px 0\"><strong>{{ $json.html.name }}</strong></td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">E-Mail</td><td style=\"padding:6px 0\"><a href=\"mailto:{{ $json.html.email }}\">{{ $json.html.email }}</a></td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Telefon</td><td style=\"padding:6px 0\">{{ $json.html.phone || '–' }}</td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Leistung</td><td style=\"padding:6px 0\">{{ $json.html.service }}</td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Eingegangen</td><td style=\"padding:6px 0\">{{ $json.receivedAt }}</td></tr>\n</table>\n<h3 style=\"margin:16px 0 6px\">Nachricht</h3>\n<div style=\"background:#f1f5f9;padding:12px;border-radius:6px\">{{ $json.html.message || '<em>Keine Nachricht</em>' }}</div>\n<p style=\"color:#64748b;font-size:12px;margin-top:16px\">Tipp: Einfach auf diese Mail antworten – die Antwort geht direkt an den Kunden.</p>\n</div>",
        "additionalFields": {
          "bodyContentType": "html",
          "replyTo": "={{ $json.data.email }}",
          "importance": "High"
        }
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000008",
      "name": "Bestätigung an Kunden",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        1100,
        220
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "={{ $('Anfrage prüfen').item.json.data.email }}",
        "subject": "Ihre Anfrage bei Duraku Glanzservice",
        "bodyContent": "=<div style=\"font-family:Arial,sans-serif;max-width:600px\">\n<p>Hallo {{ $('Anfrage prüfen').item.json.html.name }},</p>\n<p>vielen Dank für Ihre Anfrage zu <strong>{{ $('Anfrage prüfen').item.json.html.service }}</strong>. Wir haben sie erhalten und melden uns in der Regel innerhalb von 24 Stunden mit einem Angebot.</p>\n<p>Bei dringenden Fragen erreichen Sie uns telefonisch unter <a href=\"tel:+4367764165633\">0677 64165633</a>.</p>\n<p>Freundliche Grüße<br><strong>Duraku Glanzservice</strong><br>Fenster- &amp; Glasreinigung in Linz &amp; Umgebung</p>\n<hr style=\"border:none;border-top:1px solid #e2e8f0\">\n<p style=\"color:#64748b;font-size:12px\">Ihre Angaben:<br>{{ $('Anfrage prüfen').item.json.html.summary }}</p>\n</div>",
        "additionalFields": {
          "bodyContentType": "html",
          "replyTo": "duraku-glanz@outlook.com"
        }
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000009",
      "name": "Erfolg melden",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1320,
