    {
      "id": "a1f0c001-0000-4000-8000-000000000012",
      "name": "Mail an Duraku",
      "type": "n8n-nodes-base.microsoftOutlook",
      "typeVersion": 2,
      "position": [
        1540,
        380
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput",
      "parameters": {
        "resource": "message",
        "operation": "send",
        "toRecipients": "duraku-glanz@outlook.com",
        "subject": "=Neue Anfrage: {{ $('Anfrage prüfen').item.json.data.service }} – {{ $('Anfrage prüfen').item.json.data.name }}",
        "bodyContent": "=<div style=\"font-family:Arial,sans-serif;max-width:600px\">\n<h2 style=\"color:#1d4ed8;margin:0 0 12px\">Neue Anfrage über die Website</h2>\n<table style=\"border-collapse:collapse;width:100%\">\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Name</td><td style=\"padding:6px 0\"><strong>{{ $('Anfrage prüfen').item.json.html.name }}</strong></td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">E-Mail</td><td style=\"padding:6px 0\"><a href=\"mailto:{{ $('Anfrage prüfen').item.json.html.email }}\">{{ $('Anfrage prüfen').item.json.html.email }}</a></td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Telefon</td><td style=\"padding:6px 0\">{{ $('Anfrage prüfen').item.json.html.phone || '–' }}</td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Leistung</td><td style=\"padding:6px 0\">{{ $('Anfrage prüfen').item.json.html.service }}</td></tr>\n<tr><td style=\"padding:6px 12px 6px 0;color:#64748b\">Eingegangen</td><td style=\"padding:6px 0\">{{ $('Anfrage prüfen').item.json.receivedAt }}</td></tr>\n</table>\n<h3 style=\"margin:16px 0 6px\">Nachricht</h3>\n<div style=\"background:#f1f5f9;padding:12px;border-radius:6px\">{{ $('Anfrage prüfen').item.json.html.message || '<em>Keine Nachricht</em>' }}</div>\n<h3 style=\"margin:20px 0 8px\">Status setzen</h3>\n<div>{{ $('Lead vorbereiten').item.json.buttonsHtml }}</div>\n<p style=\"color:#64748b;font-size:12px;margin-top:12px\">Nach dem Klick „Angebot gesendet“ fasst das System nach 3 und 7 Tagen automatisch beim Kunden nach.\nAuf diese Mail antworten = Antwort geht direkt an den Kunden.</p>\n</div>",
        "additionalFields": {
          "bodyContentType": "html",
          "replyTo": "={{ $('Anfrage prüfen').item.json.data.email }}",
          "importance": "High"
        }
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000013",
      "name": "Bestätigung an Kunden",
