    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select docflow.stats($1, 1) as heute, docflow.stats($1, 7) as woche, docflow.stats($1, 30) as monat,\n  (select count(*) from docflow.jobs where status in ('queued','retry') and ($1 is null or mandant = $1)) as warteschlange,\n  (select count(*) from docflow.jobs where status = 'review' and ($1 is null or mandant = $1)) as zur_pruefung,\n  docflow.circuit_open() as schutzschalter_offen",
        "options": {
          "queryReplacement": "={{ [$json.query.mandant || null] }}"
        }
      },
