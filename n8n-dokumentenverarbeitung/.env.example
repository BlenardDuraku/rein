# Kopieren nach .env und Werte eintragen. Die Datei .env niemals einchecken.
N8N_VERSION=2.44.6
N8N_HOST=dokumente.example.at
N8N_ENCRYPTION_KEY=bitte-langen-zufallswert-eintragen

POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=bitte-starkes-passwort-eintragen

# Notfall-Alarm, falls die Datenbank selbst ausfällt (dann sind die Einstellungen in der DB nicht lesbar)
DOCFLOW_ALERT_WEBHOOK=https://example.webhook.office.com/...
DOCFLOW_ALERT_EMAIL=it-bereitschaft@example.at
DOCFLOW_ALERT_EMAIL_FROM=docflow@example.at
