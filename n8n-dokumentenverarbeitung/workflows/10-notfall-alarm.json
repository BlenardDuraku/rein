      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "E-Mail hinterlegt?-c1",
              "leftValue": "={{ !!$json.email_to }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "DfNotfallAlarm01-6",
      "name": "E-Mail hinterlegt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.email_from }}",
        "toEmail": "={{ $json.email_to }}",
        "subject": "={{ $json.text.slice(0, 150) }}",
        "emailFormat": "text",
        "text": "={{ $json.text + \"\\n\\n\" + JSON.stringify($json.details || {}, null, 2) }}",
        "options": {}
      },
      "id": "DfNotfallAlarm01-7",
      "name": "Per E-Mail senden",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        1440,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "DF_SMTP",
          "name": "DF SMTP"
        }
      },
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "\nconst a = $('Nachricht bauen').item.json;\nconst data = Buffer.from(JSON.stringify(a, null, 2), 'utf8').toString('base64');\nreturn { json: a, binary: { data: { data, mimeType: 'application/json', fileName: 'notfall.json' } } };"
      },
      "id": "DfNotfallAlarm01-8",
      "name": "Als Datei ablegen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/data/alerts/notfall-{{ new Date().toISOString().replace(/[:.]/g, '-') }}.json",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "DfNotfallAlarm01-9",
      "name": "Notfalldatei schreiben",
      "type": "n8n-nodes-base.readWriteFile",
