      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Totmann-Schalter konfiguriert?-c1",
              "leftValue": "={{ !!$('Zustand prüfen').first().json.w.heartbeat_url }}",
