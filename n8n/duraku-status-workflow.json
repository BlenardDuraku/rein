        "options": {}
      }
    },
    {
      "id": "b2f0c002-0000-4000-8000-000000000021",
      "name": "Anfrage suchen",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        220,
        420
      ],
      "alwaysOutputData": true,
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "duraku_anfragen",
          "cachedResultName": "duraku_anfragen"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "token",
              "condition": "eq",
              "keyValue": "={{ $json.body.t }}"
            }
          ]
        },
        "limit": 1
      }
    },
    {
      "id": "b2f0c002-0000-4000-8000-000000000022",
      "name": "Status prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        420
      ],
      "parameters": {
        "jsCode": "// n8n Code-Node \"Status prüfen\": prüft den bestätigten Status-Klick gegen die gespeicherte Anfrage.\nconst body = $('Status bestätigt').first().json.body ?? {};\n\nconst LABELS = {\n  angebot: 'Angebot gesendet',\n  auftrag: 'Auftrag erhalten',\n  erledigt: 'Erledigt',\n  abgesagt: 'Abgesagt',\n};\n\nconst token = String(body.t ?? '');\nconst action = String(body.a ?? '');\nconst row = $input\n  .all()\n  .map((item) => item.json)\n  .find((r) => r && r.token && r.token === token);\n\nconst escapeHtml = (s) =>\n  String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n\nlet changed = false;\nlet title;\nlet text;\nif (!Object.hasOwn(LABELS, action) || !row) {\n  title = 'Link ungültig';\n  text = 'Diese Anfrage wurde nicht gefunden. Bitte den Button direkt aus der E-Mail verwenden.';\n} else if (row.status === action) {\n  title = 'Schon erledigt';\n  text = `Die Anfrage von <strong>${escapeHtml(row.name)}</strong> steht bereits auf „${LABELS[action]}“.`;\n} else {\n  changed = true;\n  title = 'Gespeichert ✓';\n  text = `Die Anfrage von <strong>${escapeHtml(row.name)}</strong> steht jetzt auf „${LABELS[action]}“.`;\n}\n\nconst html = `<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\">\n<title>${title} – Duraku Glanzservice</title></head>\n<body style=\"font-family:Arial,sans-serif;max-width:420px;margin:48px auto;padding:0 16px;text-align:center;color:#0f172a\">\n<h2>${title}</h2><p>${text}</p><p style=\"color:#64748b\">Dieses Fenster kann geschlossen werden.</p></body></html>`;\n\nreturn [{ json: { changed, token, status: action, statusAt: new Date().toISOString(), html } }];\n"
      }
    },
