{
  "name": "Duraku Glanzservice – Website-Anfragen",
  "nodes": [
    {
      "id": "a1f0c001-0000-4000-8000-000000000001",
      "name": "Anfrage empfangen",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "a1f0c001-0000-4000-8000-0000000000aa",
      "parameters": {
        "httpMethod": "POST",
        "path": "duraku-anfrage",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*"
        }
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000002",
      "name": "Anfrage prüfen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "jsCode": "// n8n Code-Node \"Anfrage prüfen\": validiert und bereinigt die Formulardaten der Website.\nconst body = $input.first().json.body ?? {};\n\nconst SERVICES = ['Fensterreinigung', 'Wintergärten', 'Büroreinigung', 'Mehrere Leistungen'];\n\nconst oneLine = (v, max) => String(v ?? '').replace(/[\\u0000-\\u001F\\u007F]+/g, ' ').trim().slice(0, max);\nconst multiLine = (v, max) =>\n  String(v ?? '')\n    .replace(/\\r\\n?/g, '\\n')\n    .replace(/[\\u0000-\\u0009\\u000B-\\u001F\\u007F]+/g, ' ')\n    .replace(/\\n{3,}/g, '\\n\\n')\n    .trim()\n    .slice(0, max);\nconst escapeHtml = (s) =>\n  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;').replace(/'/g, '&#39;');\n\n// Honeypot: Das Feld \"website\" ist für Menschen unsichtbar – nur Bots füllen es aus.\nconst spam = oneLine(body.website, 200) !== '';\n\nconst data = {\n  name: oneLine(body.name, 100),\n  email: oneLine(body.email, 254).toLowerCase(),\n  phone: oneLine(body.phone, 40),\n  service: oneLine(body.service, 50),\n  message: multiLine(body.message, 3000),\n};\n\nconst errors = [];\nif (data.name.length < 2) errors.push('Bitte einen Namen angeben.');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(data.email)) errors.push('Bitte eine gültige E-Mail-Adresse angeben.');\nif (data.phone && !/^[+0-9 ()\\/-]{6,40}$/.test(data.phone)) errors.push('Telefonnummer enthält ungültige Zeichen.');\nif (!SERVICES.includes(data.service)) data.service = 'Mehrere Leistungen';\n\nconst html = Object.fromEntries(Object.entries(data).map(([k, v]) => [k, escapeHtml(v)]));\nhtml.message = html.message.replace(/\\n/g, '<br>');\nhtml.summary = [\n  `Name: ${html.name}`,\n  `E-Mail: ${html.email}`,\n  `Telefon: ${html.phone || '–'}`,\n  `Leistung: ${html.service}`,\n].join('<br>');\n\nconst receivedAt = new Date().toLocaleString('de-AT', { timeZone: 'Europe/Vienna' });\n\nreturn [{ json: { spam, valid: !spam && errors.length === 0, errors, data, html, receivedAt } }];\n"
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000003",
      "name": "Spam?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c0000001-0000-4000-8000-000000000001",
              "leftValue": "={{ $json.spam }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a1f0c001-0000-4000-8000-000000000004",
      "name": "Spam still verwerfen",
