      "typeVersion": 2.2,
      "position": [
        480,
        220
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Zustand prüfen').first().json.w.heartbeat_url }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "DfWachhund000001-6",
      "name": "Lebenszeichen senden",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        220
      ],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "55 6 * * *"
            }
          ]
        }
      },
      "id": "DfWachhund000001-7",
      "name": "Täglich 6:55",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        480
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select m.mandant, docflow.stats(case when m.mandant = 'alle' then null else m.mandant end, 1) as s,\n  docflow.setting_text('alert_email_to') as an, docflow.setting_text('alert_email_from') as von\nfrom (select distinct mandant from docflow.jobs union all select 'alle') m",
        "options": {}
      },
      "id": "DfWachhund000001-8",
      "name": "Kennzahlen laden",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        240,
        480
      ],
      "credentials": {
        "postgres": {
          "id": "DF_POSTGRES",
          "name": "DF Postgres"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "\nconst rows = $input.all().map((i) => i.json);\nconst an = rows[0] ? rows[0].an : '';\nconst von = rows[0] ? rows[0].von : '';\nconst cells = (s) => [s.empfangen, s.automatisch, s.manuell_freigegeben, s.zur_pruefung, s.abgelehnt, (s.automatisierungsquote ?? '–') + ' %', s.ki_ausfaelle];\nconst head = ['Mandant', 'Empfangen', 'Automatisch', 'Manuell freigegeben', 'Offen zur Prüfung', 'Abgelehnt', 'Automatisierung', 'KI-Ausfälle'];\nconst html = '<h2>Dokumentenverarbeitung: Tagesbericht</h2><table border=\"1\" cellpadding=\"6\" style=\"border-collapse:collapse\">'\n  + '<tr>' + head.map((h) => '<th>' + h + '</th>').join('') + '</tr>'\n  + rows.map((r) => '<tr><td>' + r.mandant + '</td>' + cells(r.s).map((c) => '<td>' + c + '</td>').join('') + '</tr>').join('')\n  + '</table><p>Zeitraum: letzte 24 Stunden.</p>';\nreturn [{ json: { an, von, html, send: !!an } }];"
      },
      "id": "DfWachhund000001-9",
      "name": "Bericht formatieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
