    {
      "id": "b2f0c002-0000-4000-8000-000000000018",
      "name": "Bestätigungsseite",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        120
      ],
      "parameters": {
        "jsCode": "// n8n Code-Node \"Bestätigungsseite\": Klick auf einen Status-Button in der Mail zeigt erst diese Seite.\n// Geändert wird erst nach dem Bestätigen – so lösen Link-Scanner von Mailprogrammen nichts aus.\nconst q = $input.first().json.query ?? {};\n\nconst LABELS = {\n  angebot: 'Angebot gesendet',\n  auftrag: 'Auftrag erhalten',\n  erledigt: 'Erledigt',\n  abgesagt: 'Abgesagt',\n};\n\nconst token = String(q.t ?? '');\nconst action = String(q.a ?? '');\nconst valid = /^[0-9a-f-]{36}$/i.test(token) && Object.hasOwn(LABELS, action);\n\nconst page = (body) => `<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta name=\"robots\" content=\"noindex\">\n<title>Status ändern – Duraku Glanzservice</title></head>\n<body style=\"font-family:Arial,sans-serif;max-width:420px;margin:48px auto;padding:0 16px;text-align:center;color:#0f172a\">\n${body}</body></html>`;\n\nconst html = valid\n  ? page(`<h2>Status ändern</h2>\n<p>Anfrage auf <strong>„${LABELS[action]}“</strong> setzen?</p>\n<form method=\"post\" action=\"duraku-status-ok\">\n<input type=\"hidden\" name=\"t\" value=\"${token}\"><input type=\"hidden\" name=\"a\" value=\"${action}\">\n<button type=\"submit\" style=\"padding:12px 24px;font-size:16px;border:0;border-radius:6px;background:#2563eb;color:#fff;cursor:pointer\">Bestätigen</button>\n</form>`)\n  : page('<h2>Ungültiger Link</h2><p>Dieser Link ist unvollständig. Bitte den Button direkt aus der E-Mail verwenden.</p>');\n\nreturn [{ json: { html } }];\n"
      }
    },
    {
      "id": "b2f0c002-0000-4000-8000-000000000019",
      "name": "Seite anzeigen",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        120
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.html }}",
        "options": {
          "responseCode": 200,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
        }
      }
    },
